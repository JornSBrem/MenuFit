# Grafana local admin login
GRAFANA_ADMIN_USER=menufit-admin
GRAFANA_ADMIN_PASSWORD=change-this-password

# Slack channel for escalations, e.g. #oncall-menufit
ALERT_SLACK_CHANNEL=#oncall-menufit

# Optional extra escalation endpoint (Ops incident webhook)
ALERT_WEBHOOK_URL=https://incident.example.com/menufit/alerts
